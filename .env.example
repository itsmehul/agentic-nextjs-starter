# Required: OpenRouter API key used by the agent and its subagents.
OPENROUTER_API_KEY=sk-or-...

# Optional: OpenRouter model ids (defaults to deepseek/deepseek-v4-flash).
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_SUBAGENT_MODEL=deepseek/deepseek-v4-flash

# Optional: rankings headers recommended by OpenRouter.
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_APP_TITLE=deploy-model

# Postgres for the LangGraph checkpointer + Better Auth (matches docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/deploy_model

# Better Auth (generate secret: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (email/password is also enabled under `next dev`). Authorized redirect URI:
# ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: enable LangSmith tracing.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-...
